{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "FAL_KEY",
    "accessKeyId",
    "secretAccessKey",
    "bucket",
    "AWS_REGION",
    "endpoint",
    "CLERK_SECRET_KEY",
    "DATABASE_URL",
    "RazorpaySecret",
    "razorpayWebhookSecret",
    "EMAIL_USER",
    "EMAIL_PASS"
  ]
}
